from typing import List


class Student:
    def __init__(self, first_name: str, last_name: str, age: int, city: str) -> None:
        self.first_name = first_name
        self.last_name = last_name
        self.age = age
        self.city = city

    def __str__(self) -> str:
        return f"{self.first_name} {self.last_name} ({self.age} y/o) - {self.city}"


class School:
    def __init__(self, name: str) -> None:
        self.name = name
        self.students: List[Student] = []

    def add_student(self, new_student: Student) -> None:
        self.students.append(new_student)

    def search_by_last_name(self, target_last_name: str) -> List[Student]:
        matched: List[Student] = []
        query = target_last_name.lower()
        for student in self.students:
            if student.last_name.lower() == query:
                matched.append(student)
        return matched

    def search_by_age(self, target_age: int) -> List[Student]:
        matched: List[Student] = []
        for student in self.students:
            if student.age == target_age:
                matched.append(student)
        return matched

    def total_students(self) -> int:
        return len(self.students)

    def __len__(self) -> int:
        return len(self.students)


class Classroom:
    def __init__(self, section: str, year: int) -> None:
        self.section = section
        self.year = year
        self.students: List[Student] = []

    def add_student(self, new_student: Student) -> None:
        self.students.append(new_student)


if __name__ == "__main__":
    my_school = School("Technical Institute")

    s1 = Student("John", "Smith", 17, "London")
    s2 = Student("Emily", "Brown", 18, "Manchester")
    s3 = Student("David", "Smith", 16, "Bristol")

    my_school.add_student(s1)
    my_school.add_student(s2)
    my_school.add_student(s3)

    print(f"School: {my_school.name} | Total students: {my_school.total_students()}")

    print("Students with last name Smith:")
    smith_students = my_school.search_by_last_name("smith")
    for student in smith_students:
        print(f"  * {student}")

    print("18-year-old students:")
    adult_students = my_school.search_by_age(18)
    for student in adult_students:
        print(f"  * {student.first_name} {student.last_name}")

    class_4b = Classroom("4B", 2026)
    class_4b.add_student(s2)
    print(f"Classroom {class_4b.section} ({class_4b.year}): {len(class_4b.students)} student(s)")